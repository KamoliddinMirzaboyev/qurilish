NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://buildscience:buildscience@localhost:5432/buildscience?schema=public
# Production: kamida 32 tasodifiy belgi. Default qiymatni prodga ko'chirmang.
SESSION_SECRET=dev-only-change-me
SESSION_COOKIE_NAME=bs_session
# Production: aniq origin ro'yxati (vergul). * taqiqlanadi.
WEB_ORIGIN=http://localhost:5174
COOKIE_SAMESITE=lax
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Password reset email. Production'da funksiyani yoqish uchun barcha SMTP qiymatlarini to'ldiring.
PASSWORD_RESET_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=BuildScience <no-reply@example.uz>
ADMIN_NAME=BuildScience Administrator
ADMIN_EMAIL=admin@buildscience.local
ADMIN_PHONE=+998901234567
ADMIN_PASSWORD=Admin12345!
# Seed: demo akkauntlar faqat non-prod. Tozalash uchun SEED_RESET=1.
